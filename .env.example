# Required: model access
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
MCP_TRANSPORT=in-process
TEMPERATURE=0

# Optional: HuggingFace auth for gated models/datasets (MiniLM is public;
# only fill this if you use a gated embedding model). Read from env only.
# HF_TOKEN=

# Optional: data locations (defaults shown; uncomment to override)
# POLICY_DIR=policy_docs
# RAG_DB=data/rag.db
# THREADS_DB=data/threads.db
# MOCK_DIR=mock_data
